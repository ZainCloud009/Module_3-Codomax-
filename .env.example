# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file - it's already in .gitignore.

# Server
PORT=3000
LOG_LEVEL=info

# Database (MariaDB, installed locally on this EC2 instance)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cloudwebapp
DB_USER=appuser
DB_PASSWORD=your-secure-password

# Object Storage (S3)
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Only needed for LOCAL development.
# On EC2, S3 credentials come from the attached IAM Role automatically - do not set these in production.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
